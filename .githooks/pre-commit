#!/usr/bin/env bash
# Converts newly-staged PNG screenshots under runs/ and golden-set/ to WebP before they land in
# history. These are Chrome/crow-nester screenshots and odiff diff images -- audit-trail artifacts
# meant to accumulate across commits (see test/lib/record-run.js) -- and run 5-10x larger as PNG
# than WebP at a quality setting that's still fine for eyeballing a diff. WebP over AVIF
# specifically because odiff-bin (test/lib/screenshot.js) lists webp as a supported read format
# and does not list avif, so stored screenshots stay usable if we ever diff them directly instead
# of always re-screenshotting from source.
#
# runs/report.html is a static snapshot generated by scripts/build-runs-report.js from whatever's
# actually on disk at generation time (a live directory listing, not a fixed manifest) -- so
# renaming files out from under an already-generated report.html would leave it pointing at
# filenames that no longer exist. Regenerating it here, only when something under runs/ changed,
# keeps it in sync with the rename.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if ! command -v cwebp >/dev/null 2>&1; then
  echo "pre-commit: cwebp not found (brew install webp) -- required to compress staged screenshots." >&2
  exit 1
fi

mapfile -t staged_pngs < <(git diff --cached --name-only --diff-filter=ACM | grep -E '^(runs|golden-set)/.*\.png$' || true)

if [ ${#staged_pngs[@]} -eq 0 ]; then
  exit 0
fi

echo "pre-commit: converting ${#staged_pngs[@]} staged PNG(s) under runs/ and golden-set/ to WebP..."

changed_runs=0
for png in "${staged_pngs[@]}"; do
  [ -f "$png" ] || continue
  webp="${png%.png}.webp"
  cwebp -quiet -q 82 "$png" -o "$webp"
  git rm --cached --quiet -- "$png"
  rm -f "$png"
  git add -- "$webp"
  case "$png" in
    runs/*) changed_runs=1 ;;
  esac
done

if [ "$changed_runs" -eq 1 ]; then
  echo "pre-commit: regenerating runs/report.html to reference the new filenames..."
  npm run --silent report:runs >/dev/null
  git add -- runs/report.html
fi
