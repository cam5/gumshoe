        "content": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Coincidental shape</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script>\n    tailwind.config = {\n      theme: {\n        extend: {\n          // The source page ships no stylesheet at all, so there is no\n          // custom palette/type-scale to extract. These utilities are used\n          // only to approximate the browser's default (UA-stylesheet) look\n          // that the original page actually renders with.\n          fontFamily: {\n            sans: ['Arial', 'Helvetica', 'sans-serif']\n          }\n        }\n      }\n    };\n  </script>\n</head>\n<body class=\"bg-white text-black font-sans text-base leading-normal\">\n  <main id=\"main\">\n    <section id=\"hero\">\n      <div>\n        <img src=\"/founder.jpg\" alt=\"Photo of the founder\" />\n        <p class=\"my-4\">Our founder started this company in a garage in 2011.</p>\n      </div>\n    </section>\n    <section id=\"specs\">\n      <div>\n        <img src=\"/spec-icon.svg\" alt=\"Weight icon\" />\n        <p class=\"my-4\">Weighs 340 grams, shipped in recyclable packaging.</p>\n      </div>\n    </section>\n  </main>\n</body>\n</html>\n"
