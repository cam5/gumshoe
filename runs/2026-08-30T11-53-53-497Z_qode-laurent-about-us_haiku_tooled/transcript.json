        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>About Us – Laurent</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Open+Sans:wght@400;600&display=swap');\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            background-color: #0a0e0e;\n            color: #c9c9c9;\n            font-family: 'Open Sans', sans-serif;\n        }\n\n        h1, h2, h3, h4, h5, h6 {\n            font-family: 'Playfair Display', serif;\n            color: #e8dcc8;\n        }\n\n        /* Header Styles */\n        header {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 100;\n            background-color: rgba(10, 14, 14, 0.95);\n            border-bottom: 1px solid rgba(156, 124, 87, 0.2);\n        }\n\n        .header-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 0 40px;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            height: 110px;\n        }\n\n        .logo {\n            flex-shrink: 0;\n        }\n\n        .logo img {\n            height: 66px;\n            width: auto;\n        }\n\n        nav {\n            flex: 1;\n            display: flex;\n            justify-content: center;\n        }\n\n        nav ul {\n            list-style: none;\n            display: flex;\n            gap: 50px;\n        }\n\n        nav a {\n            color: #c9c9c9;\n            text-decoration: none;\n            font-size: 13px;\n            letter-spacing: 0.5px;\n            text-transform: uppercase;\n            transition: color 0.3s ease;\n        }\n\n        nav a:hover,\n        nav a.active {\n            color: #9c7c57;\n        }\n\n        .menu-toggle {\n            display: none;\n            cursor: pointer;\n            color: #c9c9c9;\n        }\n\n        /* Hero Section */\n        .hero {\n            margin-top: 110px;\n            height: 900px;\n            background: linear-gradient(rgba(10, 14, 14, 0.4), rgba(10, 14, 14, 0.4)), url('https://laurent.qodeinteractive.com/wp-content/uploads/2019/11/about-us-cover.jpg');\n            background-size: cover;\n            background-position: center;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-direction: column;\n            text-align: center;\n        }\n\n        .hero h1 {\n            font-size: 72px;\n            letter-spacing: 3px;\n            text-transform: uppercase;\n            margin: 0;\n            font-weight: 400;\n        }\n\n        .accent-line {\n            width: 60px;\n            height: 1px;\n            background-color: #9c7c57;\n            margin: 0 auto;\n        }\n\n        /* Decorative SVG lines */\n        .decor-lines {\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 20px;\n            margin: 20px 0;\n        }\n\n        .decor-line {\n            width: 50px;\n            height: auto;\n        }\n\n        /* Main Content */\n        .content-section {\n            padding: 100px 40px;\n            max-width: 1400px;\n            margin: 0 auto;\n        }\n\n        .about-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr 1fr;\n            gap: 60px;\n            align-items: center;\n        }\n\n        .about-left {\n            display: flex;\n            justify-content: center;\n        }\n\n        .geometric-pattern {\n            width: 300px;\n            height: 300px;\n        }\n\n        .about-center h2 {\n      