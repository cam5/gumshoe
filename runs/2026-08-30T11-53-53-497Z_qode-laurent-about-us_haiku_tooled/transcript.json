order-top: 1px solid rgba(156, 124, 87, 0.2);\n            padding: 80px 40px;\n        }\n\n        .footer-content {\n            max-width: 1400px;\n            margin: 0 auto;\n            text-align: center;\n        }\n\n        .footer-logo img {\n            height: 46px;\n            margin-bottom: 30px;\n        }\n\n        .footer-separator {\n            width: 80px;\n            height: 2px;\n            background-color: #9c7c57;\n            margin: 30px auto;\n        }\n\n        .footer-info {\n            font-size: 13px;\n            line-height: 1.8;\n            color: #a8a8a8;\n            margin-bottom: 30px;\n        }\n\n        .footer-info a {\n            color: #9c7c57;\n            text-decoration: none;\n            transition: color 0.3s ease;\n        }\n\n        .footer-info a:hover {\n            color: #c9a876;\n        }\n\n        .footer-social {\n            display: flex;\n            justify-content: center;\n            gap: 40px;\n            margin-top: 30px;\n            font-size: 13px;\n            letter-spacing: 1px;\n            text-transform: uppercase;\n        }\n\n        .footer-social a {\n            color: #a8a8a8;\n            text-decoration: none;\n            transition: color 0.3s ease;\n        }\n\n        .footer-social a:hover {\n            color: #9c7c57;\n        }\n\n        /* Responsive */\n        @media (max-width: 1024px) {\n            .about-grid {\n                grid-template-columns: 1fr;\n                gap: 40px;\n            }\n\n            nav ul {\n                gap: 30px;\n            }\n\n            .hero h1 {\n                font-size: 48px;\n            }\n\n            .about-center h2 {\n                font-size: 36px;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .header-container {\n                padding: 0 20px;\n                height: auto;\n                flex-wrap: wrap;\n            }\n\n            nav {\n              