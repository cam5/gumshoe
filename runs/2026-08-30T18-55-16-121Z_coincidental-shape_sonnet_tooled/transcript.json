        "content": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <title>Coincidental shape</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script>\n    // This page ships no stylesheet of its own — windtailor measured only the\n    // UA-default 8px body margin and no custom color/spacing/font tokens.\n    // Keep the token set empty rather than inventing a design system that\n    // isn't there.\n    tailwind.config = {\n      theme: {\n        extend: {\n          // Preserve the browser's true default serif stack instead of\n          // letting Tailwind's preflight impose a sans-serif face.\n          fontFamily: {\n            sans: ['Times', 'Times New Roman', 'serif'],\n          },\n        },\n      },\n    };\n  </script>\n</head>\n<body class=\"m-2 block\">\n  <main id=\"main\" class=\"block\">\n    <section id=\"hero\" class=\"block\">\n      <div class=\"block\">\n        <img src=\"/founder.jpg\" alt=\"Photo of the founder\" />\n        <p class=\"block\">Our founder started this company in a garage in 2011.</p>\n      </div>\n    </section>\n    <section id=\"specs\" class=\"block\">\n      <div class=\"block\">\n        <img src=\"/spec-icon.svg\" alt=\"Weight icon\" />\n        <p class=\"block\">Weighs 340 grams, shipped in recyclable packaging.</p>\n      </div>\n    </section>\n  </main>\n</body>\n</html>\n"
      }
